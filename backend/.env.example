ENV=development
DATABASE_URL=postgresql+psycopg://cricheros:cricheros@localhost:5434/cricheros

JWT_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_MINUTES=43200

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Only honored when ENV != production. Lets you sign in locally without a real SMS provider.
OTP_DEV_BYPASS_CODE=000000

# SMS OTP delivery (MSG91) - required in production, optional in dev (falls back to
# logging the OTP + honoring OTP_DEV_BYPASS_CODE).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Cloudflare R2 (S3-compatible) file storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cricheros-uploads
R2_PUBLIC_BASE_URL=

CORS_ORIGINS=["*"]
